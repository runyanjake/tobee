# --- LLM (any OpenAI-compatible server with native tool calling) ---
# /v1/chat/completions is appended. Dev default is LM Studio on the host.
# Switching backends is configuration only: point this at Ollama, vLLM, or a
# hosted API and set AI_MODEL / AI_API_KEY to match.
AI_PROVIDER_URL=http://host.docker.internal:1234
AI_MODEL=local-model
# Bearer token for hosted APIs. Leave empty for local servers.
AI_API_KEY=
# Every phase of a turn is a tool call, not prose. Keep this low —
# sampling noise shows up as the model writing `reply_commit({...})`
# as text instead of calling it. Raise only to debug voice.
AI_TEMPERATURE=0.1
# Max tokens per completion.
AI_MAX_TOKENS=2048
# HTTP timeout for one LLM call (the turn budget usually cancels first).
AI_TIMEOUT=10m

# --- Agent ---
# Reasoning strategy. Only plan_execute exists today.
AGENT_STRATEGY=plan_execute
# Wall-clock cap on one turn.
AGENT_TURN_BUDGET=2m
# Executor LLM calls allowed within one plan step. A step that hasn't called
# step_finish by then is marked failed.
PLAN_MAX_STEPS_PER_STEP=4
# Executor LLM calls allowed across the whole turn (sum over every step).
PLAN_MAX_STEPS_TOTAL=12

# --- Discord connector (enabled when DISCORD_TOKEN is set) ---
DISCORD_TOKEN=your-bot-token-here
# Listens on all channels unless one is set here.
DISCORD_CHANNEL_ID=
# Comma-separated Discord user IDs to accept. Empty accepts everyone.
DISCORD_ALLOWED_USERS=

# --- Email connector (enabled when EMAIL_IMAP_ADDR is set) ---
# Port 993 / 465 use implicit TLS; other ports use STARTTLS.
# EMAIL_IMAP_ADDR=imap.example.com:993
# EMAIL_SMTP_ADDR=smtp.example.com:587
# EMAIL_USERNAME=tobee@example.com
# EMAIL_PASSWORD=app-password
# EMAIL_FROM=tobee@example.com
# Required. Comma-separated addresses tobee reads mail from and may send to.
# EMAIL_ALLOWED=you@example.com
# EMAIL_MAILBOX=INBOX
# EMAIL_POLL_INTERVAL=1m

# --- External MCP servers (optional) ---
# Each MCP_SERVER_<NAME> connects one server; <NAME> (lowercased) becomes the
# tool namespace (<name>_<tool>). Set exactly one of _COMMAND (stdio) or _URL
# (Streamable HTTP). External servers are untrusted unless _TRUSTED=true: they
# get no user identity, and their instructions stay out of the system prompt.
# A stdio server gets only PATH, HOME, and its _ENV_* values — never tobee's env.
#
# MCP_SERVER_FILES_COMMAND=npx -y @modelcontextprotocol/server-filesystem /data/shared
# MCP_SERVER_FILES_ENV_NODE_ENV=production
# MCP_SERVER_WEATHER_URL=https://weather.example.com/mcp
# MCP_SERVER_WEATHER_BEARER_TOKEN=...
# MCP_SERVER_WEATHER_TIMEOUT=30s
#
# A trusted server can also feed tasks: each resources/updated notification on
# a subscribed URI becomes a task whose reply goes to _REPLY_TO.
# MCP_SERVER_FEED_URL=https://feed.example.com/mcp
# MCP_SERVER_FEED_TRUSTED=true
# MCP_SERVER_FEED_SUBSCRIBE=feed://alerts
# MCP_SERVER_FEED_REPLY_TO=discord:123456789012345678

# --- Paths (defaults match the bundled layout) ---
DATA_DIR=data
PROMPTS_DIR=prompts

# --- Workspace areas (optional) ---
# Each WORKSPACE_AREA_<NAME> defines one host-filesystem area the agent can
# list / read / search / write via workspace_* tools. The <NAME> suffix is
# lowercased to form the area's identifier (what the model passes as `area`).
# Sandboxed exactly like data/memory — no .., no absolute paths, no escape.
#
# Optional companions:
#   WORKSPACE_AREA_<NAME>_DESC=human-readable purpose (shown to the model)
#   WORKSPACE_AREA_<NAME>_READONLY=true (blocks workspace_write on this area)
#
# Per-file size cap (read/write/append), bytes. Default 256 KiB.
WORKSPACE_MAX_FILE_SIZE=262144
#
# Examples (uncomment + edit):
# WORKSPACE_AREA_NOTES=/Users/you/notes
# WORKSPACE_AREA_NOTES_DESC=personal markdown notes
# WORKSPACE_AREA_PROJECTS=/Users/you/repos
# WORKSPACE_AREA_PROJECTS_DESC=local source trees
# WORKSPACE_AREA_PROJECTS_READONLY=true

# --- Logging ---
# Every line carries cat=input|thinking|action|output|llm|system, and agent
# lines carry task / phase / step for correlation. Filter by category with
# grep "cat=thinking" (text) or jq 'select(.cat=="thinking")' (json).
#
# slog level: debug | info | warn | error. Unrecognised values fall back to
# info with a warning. info records the whole reasoning chain; debug adds
# every message sent to the model and its raw responses.
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
# Max bytes of content (messages, tool args and results, replies) per log
# field; longer values are cut and marked. 0 = unlimited.
LOG_CONTENT_LIMIT=4000
