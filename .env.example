# --- LLM (OpenAI-compatible; defaults suit local LM Studio) ---
AI_PROVIDER_URL=http://host.docker.internal:1234
AI_MODEL=local-model

# --- Discord ---
DISCORD_TOKEN=your-bot-token-here
# Listens on all channels unless one is set here.
DISCORD_CHANNEL_ID=

# --- Paths (defaults match the bundled layout) ---
DATA_DIR=data
PROMPTS_DIR=prompts

# --- Retention ---
# How long a channel can sit idle before its session state (current.md and
# recent.json) is rotated to archive/ and the in-memory session is reset on
# the next message.
SESSION_IDLE_TIMEOUT=4h
# Same idea, but for one-on-one sessions (e.g. Discord DMs). DMs are bursty
# across days where channels are not, so the default is longer.
SESSION_IDLE_TIMEOUT_DM=168h
# How long a rotated archive/<timestamp>.md file is kept before the janitor
# deletes it. Accepts Go duration syntax (e.g. "24h", "168h", "720h").
SESSION_TTL=168h

# --- Workspace areas (optional) ---
# Each WORKSPACE_AREA_<NAME> defines one host-filesystem area the agent can
# list / read / search / write via workspace.* tools. The <NAME> suffix is
# lowercased to form the area's identifier (what the model passes as `area`).
# Sandboxed exactly like data/memory — no .., no absolute paths, no escape.
#
# Optional companions:
#   WORKSPACE_AREA_<NAME>_DESC=human-readable purpose (shown to the model)
#   WORKSPACE_AREA_<NAME>_READONLY=true (blocks workspace.write on this area)
#
# Per-file size cap (read/write/append), bytes. Default 256 KiB.
WORKSPACE_MAX_FILE_SIZE=262144
#
# Examples (uncomment + edit):
# WORKSPACE_AREA_NOTES=/Users/you/notes
# WORKSPACE_AREA_NOTES_DESC=personal markdown notes
# WORKSPACE_AREA_PROJECTS=/Users/you/repos
# WORKSPACE_AREA_PROJECTS_DESC=local source trees
# WORKSPACE_AREA_PROJECTS_READONLY=true
# WORKSPACE_AREA_SANDBOX=./data/workspace
# WORKSPACE_AREA_SANDBOX_DESC=scratch space tobee can freely write

# --- Plan + execution budgets ---
# Hard cap on executor LLM iterations across the whole turn (across every
# step combined). When hit, the executor stops calling tools and the
# synthesiser is asked to compose the best reply from what's been done.
PLAN_MAX_STEPS_TOTAL=12
# Hard cap on executor LLM iterations within one step. When hit without
# the model producing a terminal text response, the step is marked failed
# and the planner is given the chance to revise the plan.
PLAN_MAX_STEPS_PER_STEP=4
# Hard cap on planner.Revise calls within one turn. When hit, the agent
# stops replanning and asks the synthesiser to finalise with whatever's
# done. 0 disables replanning entirely.
PLAN_MAX_REPLANS=3

# --- Logging ---
# slog level: debug | info | warn | error. Unrecognised values fall back to
# info with a warning. debug enables per-message receive/send traces and
# turn-phase transitions; info is the production default.
LOG_LEVEL=info