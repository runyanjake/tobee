# --- LLM (OpenAI-compatible; defaults suit local LM Studio) ---
AI_PROVIDER_URL=http://host.docker.internal:1234
AI_MODEL=local-model

# --- Discord ---
DISCORD_TOKEN=your-bot-token-here
# Listens on all channels unless one is set here.
DISCORD_CHANNEL_ID=

# --- Paths (defaults match the bundled layout) ---
DATA_DIR=data
PROMPTS_DIR=prompts

# --- Retention ---
# How long a channel can sit idle before its current.md is rotated to archive/
# and the in-memory session is reset on the next message.
SESSION_IDLE_TIMEOUT=4h
# How long a rotated archive/<timestamp>.md file is kept before the janitor
# deletes it. Accepts Go duration syntax (e.g. "24h", "168h", "720h").
SESSION_TTL=168h

# --- Logging ---
DEBUG=0