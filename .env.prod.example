# Production config for docker-compose.prod.yml (bundled GPU Ollama).
# Copy to .env.prod and fill in the secrets:
#   cp .env.prod.example .env.prod

# --- LLM (points at the bundled Ollama service, not the host) ---
# The tobee client appends /v1/chat/completions; Ollama serves that path.
AI_PROVIDER_URL=http://ollama:11434
# Ollama model tag. MUST support native tool-use (tobee requires function
# calling — see .claude/DECISIONS.md D-001). Good tool-capable choices:
# qwen2.5:7b, llama3.1:8b, mistral-nemo. This is also what ollama-pull pulls.
AI_MODEL=qwen2.5:7b

# How long Ollama keeps the model resident in VRAM between turns. Longer
# avoids reload latency; "-1" keeps it loaded forever. Default if unset: 5m.
OLLAMA_KEEP_ALIVE=24h

# --- Discord ---
DISCORD_TOKEN=your-bot-token-here
# Listens on all channels unless one is set here.
DISCORD_CHANNEL_ID=

# --- Paths (defaults match the bundled layout) ---
DATA_DIR=data
PROMPTS_DIR=prompts

# --- Retention ---
# How long a channel can sit idle before its current.md is rotated to archive/
# and the in-memory session is reset on the next message.
SESSION_IDLE_TIMEOUT=4h
# How long a rotated archive/<timestamp>.md file is kept before the janitor
# deletes it. Accepts Go duration syntax (e.g. "24h", "168h", "720h").
SESSION_TTL=168h

# --- Logging ---
DEBUG=0
