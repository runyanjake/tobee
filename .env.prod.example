# Production config for docker-compose.prod.yml (bundled GPU Ollama).
# Copy to .env.prod and fill in the secrets:
#   cp .env.prod.example .env.prod
# Every variable in .env.example works here too.

# --- LLM (points at the bundled Ollama service, not the host) ---
# The tobee client appends /v1/chat/completions; Ollama serves that path.
# To use a hosted API instead, point this at it and set AI_API_KEY.
AI_PROVIDER_URL=http://ollama:11434
# Ollama model tag. Output is grammar-constrained JSON (D-041), so any
# instruction-tuned model works; tool-trained ones choose tools better:
# qwen2.5:7b, llama3.1:8b, mistral-nemo. This is also what ollama-pull pulls.
AI_MODEL=qwen2.5:7b
AI_API_KEY=
AI_TEMPERATURE=0.1

# How long Ollama keeps the model resident in VRAM between turns. Longer
# avoids reload latency; "-1" keeps it loaded forever. Default if unset: 5m.
OLLAMA_KEEP_ALIVE=24h

# --- Agent ---
# Draw lessons from failed conversations when they end (one extra model call).
AGENT_REFLECT=true

# --- Clock ---
# IANA zone for wall-clock times (reminders, <context>, status reports).
# Unset means UTC, which is almost never what the operator means.
TZ=America/Los_Angeles

# --- Discord ---
DISCORD_TOKEN=your-bot-token-here
# Listens on all channels unless one is set here.
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USERS=

# --- Paths (defaults match the bundled layout) ---
DATA_DIR=data
# The image already pins GREP_BIN=/usr/bin/grep (GNU, from the grep package).
# Only set this to point at a different binary; boot fails if it is unusable.
# GREP_BIN=/usr/bin/grep
PROMPTS_DIR=prompts

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=text
LOG_CONTENT_LIMIT=4000
